# Dependencies (workspace-hoisted root + per-app; kept out of OneDrive via junctions)
/node_modules/
satco-web*/node_modules/
satco-admin/node_modules/
packages/*/node_modules/

# Next.js build output (satco-web* = Option A + variants B/C)
satco-web*/.next/
satco-web*/out/
satco-admin/.next/

# TypeScript incremental
*.tsbuildinfo

# Dashboard local stores (mutable runtime data — the Supabase stand-in)
satco-admin/data/store/
satco-admin/data/private-uploads/
satco-admin/public/uploads/

# Env & logs
*.log
.env*
!.env.example

# OS
Thumbs.db
.DS_Store

.vercel

# Client feedback material and raw source imagery (large, personal data) — kept out of git
Feedbacks/
Images/AI Generated Pics/
