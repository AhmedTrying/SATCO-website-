# SATCO operations dashboard — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real credentials.

# ---------------------------------------------------------------- data ----
# Adapter backend: "local" (JSON files under data/, offline) or "neon" (Postgres).
DATA_BACKEND=neon

# Neon Postgres connection string — from the Neon console (or the Vercel ↔ Neon
# integration). Use the POOLED endpoint (host contains "-pooler"). Required when
# DATA_BACKEND=neon. Apply db/schema.sql with `npm run db:migrate`; existing
# databases also need db/migrations/2026-10-07-operations-dashboard.sql once.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Optional: direct (non-pooled) endpoint for single-session tools.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Vercel Blob for private CV files. Vercel adds this automatically when the
# private Blob store is connected to the dashboard project. Do not expose it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# ---------------------------------------------------------------- auth ----
# Secret used to sign the session cookie. Required in production.
#   openssl rand -base64 32
AUTH_SECRET=

# Google sign-in (free): Google Cloud console → APIs & Services → Credentials →
# "OAuth client ID" (Web application). Authorised redirect URI:
#   https://<dashboard-domain>/api/auth/google/callback   (and http://localhost:3100/... for dev)
# Only emails listed under Users & access can enter, whatever Google says.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict sign-in to one Google Workspace domain (no "@").
AUTH_ALLOWED_DOMAIN=satco.sa

# Optional: the public dashboard origin, used to build the OAuth redirect URI
# when the request origin can't be trusted (e.g. behind a proxy). No trailing slash.
AUTH_URL=

# Local only: without Google credentials the login page offers demo accounts
# from the user store. This NEVER happens in production unless you set:
# ALLOW_MOCK_AUTH=true

# ------------------------------------------------------------ public forms ----
# Comma-separated browser origins allowed to submit the contact and careers
# forms to this server. localhost:3000/3001/3002 (options A/B/C) are always allowed.
PUBLIC_SITE_ORIGINS=https://www.satco.sa,https://satco.sa

# ------------------------------------------------------------ notifications ----
# Email a department when a new inquiry arrives in its inbox. Delivery uses
# Resend's HTTP API (free tier). Leave RESEND_API_KEY empty to disable (the
# inquiry is still stored and shown in the dashboard).
RESEND_API_KEY=
NOTIFY_FROM="SATCO Website <website@satco.sa>"
# One recipient list per inquiry type (comma-separated), with a shared fallback.
INQUIRY_NOTIFY_DEFAULT=info@satco.sa
INQUIRY_NOTIFY_PARTNERSHIPS=
INQUIRY_NOTIFY_OPPORTUNITIES=
INQUIRY_NOTIFY_PROCUREMENT=
INQUIRY_NOTIFY_CAREERS=
INQUIRY_NOTIFY_GENERAL=

# ---------------------------------------------------------------- careers ----
# Optional: Vercel deploy hook for the site project. When a job is published or
# changed the dashboard pings it so the static Careers pages rebuild.
# Vercel → <site project> → Settings → Git → Deploy Hooks. Leave empty to disable.
VERCEL_DEPLOY_HOOK_URL=
# Optional: a dedicated hook for Careers changes (falls back to the one above).
CAREERS_DEPLOY_HOOK_URL=
