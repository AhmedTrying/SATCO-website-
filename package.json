{
  "name": "satco-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "satco-web",
    "satco-web-b",
    "satco-web-c",
    "satco-admin"
  ],
  "scripts": {
    "dev:web": "npm --workspace satco-web run dev",
    "dev:web-b": "npm --workspace satco-web-b run dev",
    "dev:web-c": "npm --workspace satco-web-c run dev",
    "dev:admin": "npm --workspace satco-admin run dev",
    "build:web": "npm --workspace satco-web run build",
    "build:web-b": "npm --workspace satco-web-b run build",
    "build:web-c": "npm --workspace satco-web-c run build",
    "build:admin": "npm --workspace satco-admin run build",
    "lint:web": "npm --workspace satco-web run lint",
    "lint:web-b": "npm --workspace satco-web-b run lint",
    "lint:web-c": "npm --workspace satco-web-c run lint",
    "lint:admin": "npm --workspace satco-admin run lint",
    "typecheck": "npm --workspace satco-web run typecheck && npm --workspace satco-web-b run typecheck && npm --workspace satco-web-c run typecheck && npm --workspace satco-admin run typecheck",
    "sync:variants": "tsx satco-web-b/scripts/sync-content-from-a.mts && tsx satco-web-c/scripts/sync-content-from-a.mts",
    "db:migrate": "tsx satco-admin/scripts/db-migrate.mts",
    "db:seed": "tsx satco-admin/scripts/db-seed.mts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  }
}
