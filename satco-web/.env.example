# Full URL of the dashboard's public job-application endpoint. Local development
# falls back to localhost:3100 automatically; set this for production builds.
NEXT_PUBLIC_CAREERS_API_URL=http://localhost:3100/api/public/job-applications

# Server-only endpoint read during the static site build. It must point to the
# admin public jobs endpoint and is refreshed by the Careers deploy hook.
CAREERS_JOBS_API_URL=http://localhost:3100/api/public/jobs
