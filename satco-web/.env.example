# Full URL of the dashboard's public job-application endpoint. The browser also
# derives /api/public/jobs (live listings) and /api/public/inquiries (the contact
# form) from this origin.
# Local development falls back to localhost:3100; the Vercel site falls back to
# satco-dashboard.vercel.app when this variable is not set.
NEXT_PUBLIC_CAREERS_API_URL=http://localhost:3100/api/public/job-applications

# Optional, server-only: Neon URL used at build time as a fallback source for
# published jobs when the dashboard API is unavailable. Page copy is never
# fetched — it lives in content/generated/*.json and is edited in code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Optional build-time jobs source. On Vercel the known dashboard URL is used as
# a fallback automatically. No browser access to this endpoint is required.
# CAREERS_JOBS_API_URL=https://YOUR-DASHBOARD.vercel.app/api/public/jobs
